# Frontend Vercel project only. No PostgreSQL URLs/passwords/API keys here.
# Set to the canonical Backend Vercel HTTPS origin, without /api/v1.
SPMS_BACKEND_ORIGIN=https://your-backend-project.vercel.app
# Remove NEXT_PUBLIC_API_BASE_URL in Vercel. next.config sets it to empty string
# for same-origin /api/v1 calls; do not set it to the Backend domain.
