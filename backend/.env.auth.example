# Copy to backend/.env only if it does not exist; fill secrets locally.
# PostgreSQL role project_app; default local test DB is pinned by the Backend.
# Supabase is a separate opt-in profile: see docs/team/SUPABASE_SETUP.md.
AUTH_DB_TARGET=local_test
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_PASSWORD=
