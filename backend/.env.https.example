# Backend process / hosting environment only. No passwords in this template.
# Read by environment, not automatically loaded from this example or .env.
# One canonical HTTPS frontend origin; no wildcard, path or API endpoint.
# When set, session cookies use Secure and allowed origins exclude localhost.
AUTH_WEB_ORIGIN=https://your-frontend-project.vercel.app
# Database settings remain in .env.supabase.example; credentials only on Backend.
