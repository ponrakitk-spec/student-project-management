# Runtime-only template for an explicitly approved disposable Supabase project.
# Do not overwrite an existing .env. Fill secrets locally; never put in frontend.
AUTH_DB_TARGET=supabase_test
SUPABASE_PROJECT_REF=
# Approved test project (2026-11-18): czylcqdmtzztabkcqewn
# Set SUPABASE_PROJECT_REF to this value only after baseline/config verification.
# Copy a Direct or Session pooler URL from Connect. Use project_app, not postgres.
# Direct: user=project_app; Session pooler: user=project_app.<project-ref>.
# Database=postgres, port=5432, sslmode=require (or verify-full + sslrootcert).
# Password must be URL encoded. No anon/service_role/publishable/secret API keys.
AUTH_DATABASE_URL=
